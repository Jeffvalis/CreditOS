{
  "name": "creditos-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "start:gateway": "ts-node src/index.ts",
    "dev:gateway": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start:kyc": "ts-node services/identity-kyc/src/index.ts",
    "start:decision": "ts-node services/decision-engine/src/index.ts",
    "start:payment": "ts-node services/payment-processing/src/index.ts",
    "start:ledger": "ts-node services/core-ledger-loan/src/index.ts",
    "start:all": "concurrently \"npm run start:gateway\" \"npm run start:kyc\" \"npm run start:decision\" \"npm run start:payment\" \"npm run start:ledger\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
